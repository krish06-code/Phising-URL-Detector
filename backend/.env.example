# PhishGuard Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. Only commit .env.example.

# Port for the Express.js backend server
PORT=3001

# URL of the Python FastAPI ML inference service
# This must match where you start uvicorn
ML_SERVICE_URL=http://localhost:8000

# How long to wait (in ms) before giving up on the ML service
ML_SERVICE_TIMEOUT_MS=10000

# Allowed origins for CORS (comma-separated)
# The Chrome extension uses chrome-extension:// scheme — we handle this specially in app.js
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Node environment (development or production)
NODE_ENV=development
